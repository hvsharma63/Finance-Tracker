# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
DB_PORT=5433

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_long_random_secret
# Used when running the backend directly on the host (not in docker)
DATABASE_URL=postgresql+psycopg://finance:CHANGE_ME_long_random_password@127.0.0.1:5433/finance
TEST_DATABASE_URL=postgresql+psycopg://finance:CHANGE_ME_long_random_password@127.0.0.1:5433/finance_test
STORAGE_DIR=../private/statements
BACKUP_DIR=../private/backups
AUTH_ENABLED=true
# Comma separated. Leave empty in docker (frontend and API share an origin via nginx).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true only when served over HTTPS
COOKIE_SECURE=false
OCR_ENABLED=true
# Path to tesseract.exe on Windows if it is not on PATH
TESSERACT_CMD=
# Days to keep uploaded statement files (0 = keep forever)
DOCUMENT_RETENTION_DAYS=0

# --- Frontend / exposure ---
APP_PORT=8420
# 127.0.0.1 = this machine only. Use a private LAN IP only on a trusted network.
BIND_ADDRESS=127.0.0.1
